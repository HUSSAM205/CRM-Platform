# Reference env vars for a full deployment (frontend + backend containers).
# Local dev uses backend/.env and frontend/.env.local directly; this file
# documents the combined set for a docker-compose / hosted deployment.

# --- Backend ---
DATABASE_URL=postgresql+psycopg://user:password@host/dbname?sslmode=require
JWT_SECRET=
REFRESH_SECRET=
CORS_ORIGINS=["https://your-frontend-domain.com"]
STORAGE_BACKEND=s3
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=

# --- Frontend ---
NEXT_PUBLIC_API_URL=https://your-backend-domain.com
