# Reference env vars for infra/docker-compose.yml. Copy to infra/.env (docker compose
# auto-loads a .env file next to the compose file) and fill in real secrets.
#
# Local dev on this project does NOT need this file - it uses backend/.env (pointed at
# Neon) and frontend/.env.local directly. This is for a Docker-based deployment or for
# self-hosting Postgres instead of Neon.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
REFRESH_SECRET=

# --- Frontend build-time value (baked into the client bundle) ---
# Override the ARG in infra/docker-compose.yml's frontend build.args if this isn't
# http://localhost:8000 (e.g. a real domain in a hosted deployment).
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Not yet used by docker-compose.yml, but documented for a future hosted deploy ---
# The backend's StorageService currently only implements a local-disk adapter
# (backend/app/services/storage_service.py); swap STORAGE_BACKEND to "s3" once an
# S3-compatible adapter is added there, then set these:
# STORAGE_BACKEND=s3
# S3_ENDPOINT_URL=
# S3_ACCESS_KEY=
# S3_SECRET_KEY=
# S3_BUCKET=
